# Set default behavior to normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare file types to ensure consistent handling
*.py text
*.md text
*.txt text
*.yaml text
*.yml text
*.toml text
*.json text
*.sh text eol=lf
*.bash text eol=lf
*.fish text eol=lf

# Scripts should always use LF
*.py text eol=lf
*.sh text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.svg binary
*.zip binary
*.tar.gz binary
*.parquet binary
*.pkl binary
*.pth binary
*.onnx binary
*.bin binary
*.npy binary
*.npz binary
*.ipynb binary

# Lock files should use LF to avoid cross-platform issues
uv.lock text eol=lf
poetry.lock text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
pnpm-lock.yaml text eol=lf
